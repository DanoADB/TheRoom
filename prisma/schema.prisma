generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParticipantType {
  HUMAN
  AGENT
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryMode {
  POLLING
  WEBHOOK
}

enum MessageSourceType {
  STATEMENT
}

enum GalleryItemKind {
  INITIAL
  INTERNET_IMAGE
}

enum FeedbackValue {
  UP
  DOWN
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  displayName    String
  type           ParticipantType @default(HUMAN)
  accessCodeHash String?         @unique
  createdAt      DateTime        @default(now())

  memberships RoomMembership[]
  messages    Message[]
  sessions    HumanSession[]
  feedback    MessageFeedback[]

  @@map("users")
}

model HumanSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("human_sessions")
}

model Agent {
  id           String          @id @default(uuid()) @db.Uuid
  displayName  String
  type         ParticipantType @default(AGENT)
  status       AgentStatus     @default(ACTIVE)
  deliveryMode DeliveryMode    @default(POLLING)
  webhookUrl   String?
  apiTokenHash String?         @unique
  createdAt    DateTime        @default(now())

  memberships RoomMembership[]
  messages    Message[]
  cursors     AgentRoomCursor[]
  profile     AgentProfile?
  curiosity   AgentCuriosity?
  curiosities RoomCuriosity[]
  gallery     AgentGalleryItem[]

  @@map("agents")
}

model AgentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @unique @db.Uuid
  content   String   @db.Text
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model AgentCuriosity {
  id             String    @id @default(uuid()) @db.Uuid
  agentId        String    @unique @db.Uuid
  interests      Json      @default("[]")
  lastExploredAt DateTime?
  researchDay    String?
  researchCount  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_curiosity")
}

model Room {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  nextSequence Int      @default(0)
  createdAt    DateTime @default(now())

  memberships  RoomMembership[]
  messages     Message[]
  agentCursors AgentRoomCursor[]
  curiosities  RoomCuriosity[]

  @@map("rooms")
}

model RoomCuriosity {
  id            String   @id @default(uuid()) @db.Uuid
  roomId        String   @db.Uuid
  agentId       String   @db.Uuid
  kind          String   @db.VarChar(32)
  title         String   @db.VarChar(140)
  reason        String?  @db.VarChar(280)
  sourceMessage String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([roomId, kind])
  @@index([agentId])
  @@map("room_curiosities")
}

model AgentGalleryItem {
  id         String          @id @default(uuid()) @db.Uuid
  agentId    String          @db.Uuid
  kind       GalleryItemKind @default(INITIAL)
  title      String          @db.VarChar(140)
  provenance String          @db.VarChar(280)
  imageUrl   String?
  visualMeta Json            @default("{}")
  steerAway  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, kind])
  @@index([agentId, steerAway])
  @@map("agent_gallery_items")
}

model AgentCuriositiesView {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @db.Uuid
  topic     String   @db.VarChar(100)
  why       String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@ignore
}

model AgentRoomCursor {
  id               String   @id @default(uuid()) @db.Uuid
  agentId          String   @db.Uuid
  roomId           String   @db.Uuid
  lastSeenSequence Int      @default(0)
  updatedAt        DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([agentId, roomId])
  @@index([roomId])
  @@map("agent_room_cursors")
}

model RoomMembership {
  id              String          @id @default(uuid()) @db.Uuid
  roomId          String          @db.Uuid
  participantType ParticipantType
  userId          String?         @db.Uuid
  agentId         String?         @db.Uuid
  joinedAt        DateTime        @default(now())

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@unique([roomId, agentId])
  @@index([userId])
  @@index([agentId])
  @@map("room_memberships")
}

model Message {
  id         String            @id @default(uuid()) @db.Uuid
  roomId     String            @db.Uuid
  authorType ParticipantType
  userId     String?           @db.Uuid
  agentId    String?           @db.Uuid
  content    String            @db.Text
  sequence   Int
  sourceType MessageSourceType @default(STATEMENT)
  metadata   Json              @default("{}")
  createdAt  DateTime          @default(now())

  room     Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent    Agent?            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  feedback MessageFeedback[]
  attachments MessageAttachment[]

  @@unique([roomId, sequence])
  @@index([roomId, createdAt])
  @@index([userId])
  @@index([agentId])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  sortOrder Int      @default(0)
  fileName  String   @db.VarChar(255)
  mimeType  String   @db.VarChar(32)
  byteSize  Int
  data      Bytes    @db.ByteA
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, sortOrder])
  @@index([messageId])
  @@map("message_attachments")
}

model MessageFeedback {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @db.Uuid
  userId    String        @db.Uuid
  value     FeedbackValue
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("message_feedback")
}
